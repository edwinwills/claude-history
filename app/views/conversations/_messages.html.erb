<% forkable = local_assigns[:conversation]&.code? %>
<div class="flex flex-col gap-3">
  <% messages.each do |message| %>
    <% is_user = message.role == 'user' %>
    <div class="group flex <%= is_user ? 'justify-end' : 'justify-start' %>" id="msg-<%= message.uuid %>">
      <div class="max-w-3xl w-fit">
        <div class="flex items-center gap-2 text-xs text-muted-foreground mb-1 <%= 'justify-end' if is_user %>">
          <span class="uppercase tracking-wide"><%= message.role %></span>
          <span><%= message.timestamp&.strftime("%H:%M:%S") %></span>
          <% if forkable && message.uuid.present? %>
            <%= button_to "Resume from here",
                  conversation_forks_path(conversation, message_uuid: message.uuid),
                  form: { class: "inline" },
                  title: "Copy a command that resumes a fork of this session after this turn",
                  class: "opacity-0 group-hover:opacity-100 focus:opacity-100 rounded px-1.5 py-0.5 border border-border hover:bg-accent hover:text-accent-foreground transition-opacity" %>
          <% end %>
        </div>
        <div class="rounded-lg px-4 py-3 border <%= is_user ? 'bg-primary/10 border-primary/30' : 'bg-card border-border' %>">
          <div class="markdown-body text-sm">
            <% message.content_blocks.each do |block| %>
              <%= render "conversations/block", block: block %>
            <% end %>
          </div>
        </div>
        <% if forkable && message.uuid.present? %>
          <div id="fork-slot-<%= message.uuid %>"></div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
