<% if error %>
  <p class="mt-2 text-xs text-destructive"><%= error %></p>
<% else %>
  <div class="mt-2 rounded-md border border-border bg-card p-2" data-controller="clipboard">
    <div class="text-[10px] uppercase tracking-wide text-muted-foreground mb-1">Resume a fork from this point</div>
    <div class="flex gap-2 items-center">
      <code class="flex-1 font-mono text-xs bg-muted/40 rounded-sm px-2 py-1.5 break-all" data-clipboard-target="source"><%= fork.resume_command %></code>
      <button type="button"
              class="inline-flex items-center justify-center rounded-md text-xs font-medium h-7 px-3 bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
              data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
    </div>
  </div>
<% end %>
